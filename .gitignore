# Python
__pycache__/
*.py[cod]
*.so
.Python
venv/
.venv/
env/

# Secrets — NEVER commit
.env
*.env
!.env.example

# Databases
*.db
*.db-wal
*.db-shm

# Logs (rotated locally, not tracked)
logs/
*.log

# Generated datasets / model artifacts (large, reproducible)
data/entry_v2/
data/exit_v2/
models_backup/
models/tmp_*.json
models/test_*.json
models/entry/research/
# Scratch research output only. This was once a bare `research/`, which matches
# every directory of that name at any depth — it silently excluded the research
# model integration's source (analysis/research/), its artifacts
# (models/research/) and its test fixtures. Scoped to the paths that actually
# hold generated output.
models/*/research/
data/research/
reports/research/

# Reports & scratch output
reports/output/
*.bak
*.bak[0-9]
tmp_*
temp_*

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# DB backups (local safety copies)
backups/
