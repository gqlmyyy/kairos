from __future__ import annotations

import time
from datetime import datetime, timezone
from typing import Any, Dict, Optional

from utils.logger import get_logger
from data.storage.database import update_execution_mfe_mae
from data.market.hybrid_client import get_indicators_hybrid
from data.market.client import get_candles
from scripts.import_historical_trades import calculate_adx

logger = get_logger("xgboost_exit_adapter")


class XGBoostExitModelAdapter:
    """Returns probabilities only; does not modify MT5 nor telegram.

    NOTE: exit-model adapter is QuantDinger-only for indicator calculation.
    """

    # Exit model timeframe MUST match training TFs (see expected_* columns).
    # Using H4 by contract for ATR/ADX-like features.
    EXIT_MODEL_TIMEFRAME = "H4"

    def __init__(self) -> None:
        # Cache last valid values to reduce model jitter when ADX/trend isn't available this cycle.
        self._last_valid_adx: Optional[float] = None
        self._last_valid_trend_h1: Optional[float] = None
        self._last_valid_trend_h4: Optional[float] = None

    def get_atr_safe(self, symbol: Optional[str], timeframe_h: Optional[int], period: int = 14) -> float:
        """جلب ATR مع منطق احتياطي.
        - إذا ATR جاء 0.0/غير صالح => نحاول حسابه من الشموع
        - إذا فشل الحساب => قيمة افتراضية حسب الزوج
        - الهدف: ضمان عدم منع النموذج بالتبعية عبر atr=0.
        """
        sym = (symbol or "").strip()
        if not sym:
            default_atr = 0.001
            logger.warning(f"[EXIT_MODEL] ATR symbol missing → using default ATR={default_atr}")
            return default_atr

        default_atr = {
            "EURUSD": 0.001,
            "GBPUSD": 0.002,
            "XAUUSD": 35.0,
            "USDJPY": 0.5,
        }.get(sym.upper(), 0.001)

        # Ensure mt5 module is available
        try:
            import MetaTrader5 as mt5_local  # type: ignore
        except Exception:
            mt5_local = None

        # Map timeframe_h -> MT5 timeframe for ATR candles
        # timeframe_h: 1 => H1, 4 => H4; fallback to H1
        tf = None
        try:
            if mt5_local is not None and timeframe_h in (1, 4):
                tf = mt5_local.TIMEFRAME_H1 if timeframe_h == 1 else mt5_local.TIMEFRAME_H4
        except Exception:
            tf = None

        if tf is None and mt5_local is not None:
            # best-effort fallback: H1
            try:
                tf = mt5_local.TIMEFRAME_H1
            except Exception:
                tf = None

        # 1) best-effort compute from candles
        try:
            if mt5_local is not None and tf is not None:
                # request period+1 bars to have enough TR calculations
                rates = mt5_local.copy_rates_from_pos(sym, tf, 0, period + 1)
                if rates is not None and len(rates) >= period + 1:
                    # Compute ATR (simple Wilder-like approximation using TR series)
                    # TR = max(high-low, abs(high-prev_close), abs(low-prev_close))
                    closes = [float(r["close"]) for r in rates]
                    highs = [float(r["high"]) for r in rates]
                    lows = [float(r["low"]) for r in rates]

                    trs = []
                    for i in range(1, len(rates)):
                        high = highs[i]
                        low = lows[i]
                        prev_close = closes[i - 1]
                        tr = max(
                            high - low,
                            abs(high - prev_close),
                            abs(low - prev_close),
                        )
                        trs.append(tr)

                    if len(trs) >= period:
                        # ATR = average of first `period` TRs as a pragmatic fallback
                        atr_val = sum(trs[-period:]) / float(period)
                        if atr_val is not None and atr_val > 0:
                            logger.info(f"[EXIT_MODEL] ATR calculated from candles: {atr_val} (symbol={sym})")
                            return float(atr_val)
        except Exception as e:
            logger.warning(f"[EXIT_MODEL] ATR candle fallback failed (symbol={sym}): {e}")

        logger.warning(f"[EXIT_MODEL] Using default ATR for {sym}: {default_atr}")
        return float(default_atr)

    def get_mt5_time_safe(self, symbol: Optional[str]) -> datetime:
        """الحصول على الوقت الصحيح من MT5 (UTC) مع fallback."""
        try:
            import MetaTrader5 as mt5_local  # type: ignore
        except Exception:
            mt5_local = None

        if mt5_local is None:
            return datetime.now(timezone.utc)

        try:
            tick_symbol = symbol or "EURUSD"
            tick = mt5_local.symbol_info_tick(str(tick_symbol))
            if tick is not None and getattr(tick, "time", None):
                # MT5 tick.time is usually unix epoch seconds
                t = float(tick.time)
                return datetime.fromtimestamp(t, tz=timezone.utc)
        except Exception:
            pass

        return datetime.now(timezone.utc)

    def update_mfe_mae(
        self,
        position_state: Optional[Any],
        current_profit: float,
        order_id: Optional[Any] = None,
    ) -> tuple[float, float]:
        """Update position_state.mfe/mae tracking and return (mfe, mae).

        Also persists mfe/mae into execution_dataset so ProfitDecay works after restart.
        """
        if position_state is None:
            return 0.0, 0.0

        state_mfe = getattr(position_state, "mfe", 0.0)
        state_mae = getattr(position_state, "mae", 0.0)

        mfe = state_mfe
        mae = state_mae

        if current_profit > state_mfe:
            mfe = current_profit
            position_state.mfe = mfe
        else:
            mfe = state_mfe

        if current_profit < state_mae:
            mae = current_profit
            position_state.mae = mae
        else:
            mae = state_mae

        if order_id is not None:
            try:
                update_execution_mfe_mae(order_id=str(order_id), mfe=float(mfe), mae=float(mae))
            except Exception:
                # non-fatal: red flags will still work in-memory
                pass

        return float(mfe), float(mae)

    def predict(
        self,
        snapshot: Dict[str, Any],
        position_state: Optional[Any] = None,
    ) -> Dict[str, Optional[float]]:
        try:
            from analysis.models.xgboost_exit_model import predict_exit_probability
        except Exception:
            logger.warning("[EXIT_MODEL] IMPORT/CALL FAILED - predict_exit_probability import failed")
            return {"continue_probability": None, "exit_probability": None, "confidence": None}

        # Build features from MT5 live data + expected_row
        trade = snapshot.get("trade", {})
        expected_row = snapshot.get("expected_row") or {}

        # ============ time_open_hours ============
        # MT5 `position.time` / `trade["time_open"]` comes in broker server time (not UTC).
        # We convert it to UTC-equivalent by subtracting BROKER_UTC_OFFSET_HOURS.
        time_open_hours = 0.0
        time_open_ts = trade.get("time_open")

        if time_open_ts:
            try:
                from config import BROKER_UTC_OFFSET_HOURS

                offset_seconds = float(BROKER_UTC_OFFSET_HOURS) * 3600.0
                now_ts_utc = time.time()

                open_ts_utc = None

                # Handle different formats from MT5
                if hasattr(time_open_ts, "timestamp"):
                    # datetime object from MT5 (often naive broker time)
                    # Convert by treating it as broker-local and shifting to UTC.
                    ts_broker = float(time_open_ts.timestamp())
                    open_ts_utc = ts_broker - offset_seconds
                elif isinstance(time_open_ts, (int, float)):
                    # Unix timestamp in broker time
                    open_ts_utc = float(time_open_ts) - offset_seconds
                elif isinstance(time_open_ts, str):
                    # ISO string (naive broker datetime string)
                    parsed = time_open_ts.replace("+00:00", "").replace("Z", "")
                    dt = time.strptime(parsed[:19], "%Y-%m-%d %H:%M:%S")
                    ts_broker = float(time.mktime(dt))
                    open_ts_utc = ts_broker - offset_seconds

                if open_ts_utc is not None:
                    time_open_hours = (now_ts_utc - open_ts_utc) / 3600.0
                    time_open_hours = max(0.0, min(time_open_hours, 168.0))  # Cap at 1 week
            except Exception:
                time_open_hours = 0.0
        else:
            # Fallback: estimate from current profit if no time_open
            pass

        # ============ spread ============
        spread = float(trade.get("spread") or 0)
        if spread <= 0 and position_state is not None:
            spread = float(getattr(position_state, "last_spread", 0))
        if spread <= 0:
            spread = 15.0  # 1.5 pips typical

        # ============ MFE / MAE ============
        current_profit = float(trade.get("profit") or 0)
        if position_state is not None:
            order_id = trade.get("order_id")
            mfe, mae = self.update_mfe_mae(
                position_state=position_state,
                current_profit=current_profit,
                order_id=order_id,
            )
        else:
            # Fallback: use expected_row values
            mfe = float(expected_row.get("mfe") or current_profit if current_profit > 0 else 0)
            mae = float(expected_row.get("mae") or current_profit if current_profit < 0 else 0)

        # ============ profit_decay_pct ============
        profit_decay_pct = 0.0
        if mfe > 0:
            if current_profit > 0:
                profit_decay_pct = max(0.0, (mfe - current_profit) / mfe * 100.0)
            else:
                profit_decay_pct = 100.0 + abs(current_profit)
        elif current_profit <= 0:
            profit_decay_pct = 0.0
        else:
            profit_decay_pct = 0.0

        profit_decay_pct = min(profit_decay_pct, 200.0)

        # ============ ATR / RSI ============
        atr = float(expected_row.get("expected_atr") or 0)
        rsi = float(expected_row.get("expected_rsi") or 50)

        # Task #1/2: QuantDinger-only ATR.
        # EXIT_MODEL_TIMEFRAME must match training TF and expected_* columns.
        if atr <= 0.0:
            sym = trade.get("symbol") or expected_row.get("symbol")
            try:
                atr = float(
                    (get_indicators_hybrid(str(sym), timeframe="H4") or {}).get("atr")
                )
            except Exception:
                atr = 0.0

        # ============ p_win (winning probability) ============
        # NOTE: This adapter's model outputs probability of reversal/ending in loss
        # (see analysis/models/xgboost_exit_model.py). TradeHealthFlag expects
        # `expected_row['p_win']` in range [0..1].
        #
        # Previously, this code used a hard fallback (50) which effectively forced a
        # constant health score (0.5 * 100 = 50). We remove that behavior by deriving
        # p_win from model/fallback probability later in the function.
        p_win = None

        # ============ Missing model features (adx/session/trend_h1/trend_h4) ============
        # NOTE:
        # - Current snapshot builder provides `adx` and generic `trend` only.
        # - execution_dataset may not contain expected_adx/expected_trend_h1/h4 columns.
        # To avoid feeding None/"MISSING" into the model pipeline, we derive fallbacks
        # from whatever fields exist in snapshot + expected_row.

        def _safe_float(x: Any, default: Optional[float] = None) -> Optional[float]:
            try:
                if x is None:
                    return default
                # filter common missing strings
                if isinstance(x, str):
                    s = x.strip().lower()
                    if s in {"", "none", "null", "nan", "missing", "mISSING"}:
                        return default
                return float(x)
            except Exception:
                return default

        def _is_missing_numeric(v: Any) -> bool:
            if v is None:
                return True
            try:
                # missing strings already handled, but keep defensive
                if isinstance(v, str):
                    s = v.strip().lower()
                    if s in {"", "none", "null", "nan", "missing", "mISSING"}:
                        return True
                return float(v) == 0.0
            except Exception:
                return True

        # Best-effort compute ADX/trend from MT5 if expected_row lacks them.
        # We keep this local (no behavior change to _safe_float).
        def _compute_adx_and_trends_from_mt5(symbol: Optional[str], timeframe_h: int) -> tuple[Optional[float], Optional[float]]:
            """
            Returns (adx14, trend_value) where trend_value is best-effort numeric proxy:
            - positive -> bullish trend, negative -> bearish trend, 0 -> neutral.
            """
            try:
                if symbol is None or mt5 is None:
                    return None, None

                import MetaTrader5 as mt5_local  # type: ignore
                if mt5_local is None:
                    return None, None

                # timeframe_h: 1 => H1, 4 => H4
                tf_map = {
                    1: mt5_local.TIMEFRAME_H1,
                    4: mt5_local.TIMEFRAME_H4,
                }
                tf = tf_map.get(timeframe_h)
                if tf is None:
                    return None, None

                rates = mt5_local.copy_rates_from_pos(symbol, tf, 0, 200)
                if rates is None or len(rates) < 30:
                    return None, None

                # ADX(14) via analysis/technical/indicators to keep consistent math (if available)
                try:
                    from analysis.technical.indicators import compute_adx  # type: ignore
                    adx_v = compute_adx(rates, period=14)
                    adx_f2 = _safe_float(adx_v, default=None)
                except Exception:
                    # If indicator helper isn't available, fallback: no ADX
                    adx_f2 = None

                # Trend proxy: compare last close vs close[1] in price units.
                # If we can compute it, represent direction as +1/-1/0 scaled by move.
                try:
                    closes = [float(r["close"]) if isinstance(r, dict) else float(getattr(r, "close")) for r in rates]  # type: ignore
                    if len(closes) >= 2:
                        move = closes[-1] - closes[-2]
                        trend_proxy = move
                    else:
                        trend_proxy = None
                except Exception:
                    trend_proxy = None

                return adx_f2, trend_proxy
            except Exception:
                return None, None

        # ADX: prefer expected_row fields, else snapshot/trade snapshot
        adx = (
            expected_row.get("expected_adx")
            or expected_row.get("actual_adx")
            or expected_row.get("adx")
            or trade.get("adx")
        )

        # Missing? compute from MT5 and apply last-valid fallback or -1.0
        if _is_missing_numeric(adx):
            sym = trade.get("symbol") or expected_row.get("symbol") or None
            adx_computed, _trend_dummy = _compute_adx_and_trends_from_mt5(sym, timeframe_h=1)
            if adx_computed is not None:
                self._last_valid_adx = float(adx_computed)
                adx = self._last_valid_adx
            elif self._last_valid_adx is not None:
                adx = self._last_valid_adx
            else:
                adx = -1.0

        adx_f = _safe_float(adx, default=0.0)

        # session is optional; historical training may not include it.
        # If present, keep as string and it will be encoded inside feature_schema.
        session = None
        if time_open_ts:
            try:
                import datetime as dt_module

                if hasattr(time_open_ts, "timestamp"):
                    dt = dt_module.datetime.fromtimestamp(time_open_ts.timestamp(), tz=dt_module.timezone.utc)
                elif isinstance(time_open_ts, (int, float)):
                    dt = dt_module.datetime.fromtimestamp(float(time_open_ts), tz=dt_module.timezone.utc)
                elif isinstance(time_open_ts, str):
                    parsed = time_open_ts.replace("+00:00", "").replace("Z", "")
                    dt = dt_module.datetime.strptime(parsed[:19], "%Y-%m-%d %H:%M:%S").replace(
                        tzinfo=dt_module.timezone.utc
                    )
                else:
                    dt = None

                if dt is not None:
                    h = dt.hour
                    if 0 <= h < 7:
                        session = "asia"
                    elif 7 <= h < 13:
                        session = "london"
                    else:
                        session = "new_york"
            except Exception:
                session = None

        # trend_h1 / trend_h4:
        # prefer expected_row if present; else fall back to generic `trend`
        # (may be numeric already, or non-numeric -> becomes 0.0 via _safe_float)
        trend_generic = expected_row.get("trend") or trade.get("trend") or expected_row.get("market_trend")
        trend_h1 = (
            expected_row.get("expected_trend_h1")
            or expected_row.get("trend_h1")
            or trend_generic
        )
        trend_h4 = (
            expected_row.get("expected_trend_h4")
            or expected_row.get("trend_h4")
            or trend_generic
        )

        # If missing from expected_row, compute from MT5 and apply fallback.
        if _is_missing_numeric(trend_h1) or _is_missing_numeric(trend_h4):
            sym = trade.get("symbol") or expected_row.get("symbol") or None

            # Compute H1 proxy
            adx_h1, trend_h1_computed = _compute_adx_and_trends_from_mt5(sym, timeframe_h=1)
            if trend_h1_computed is not None:
                self._last_valid_trend_h1 = float(trend_h1_computed)
                trend_h1 = self._last_valid_trend_h1
            elif self._last_valid_trend_h1 is not None:
                trend_h1 = self._last_valid_trend_h1
            else:
                trend_h1 = -1.0

            # Compute H4 proxy
            adx_h4, trend_h4_computed = _compute_adx_and_trends_from_mt5(sym, timeframe_h=4)
            if trend_h4_computed is not None:
                self._last_valid_trend_h4 = float(trend_h4_computed)
                trend_h4 = self._last_valid_trend_h4
            elif self._last_valid_trend_h4 is not None:
                trend_h4 = self._last_valid_trend_h4
            else:
                trend_h4 = -1.0

        trend_h1_f = _safe_float(trend_h1, default=0.0)
        trend_h4_f = _safe_float(trend_h4, default=0.0)

        # ============ Build features ============
        # Provide trade_health as [0..100] for any downstream logic/model features
        # that still expects the legacy scale. If p_win is not available yet,
        # derive from current `mfe/mae` fallback heuristics using profit_decay_pct.
        # This value will not be used by TradeHealthFlag after we set `expected_row['p_win']`.
        legacy_trade_health = float(expected_row.get("p_win") or 0.5) * 100.0

        features = {
            "symbol": trade.get("symbol"),
            "direction": trade.get("direction"),
            "atr": atr,
            "rsi": rsi,
            "mfe": mfe,
            "mae": mae,
            "trade_health": legacy_trade_health,
            "profit_decay_pct": profit_decay_pct,
            "time_open_hours": time_open_hours,
            "spread": spread,
            "news_impact": expected_row.get("expected_news_impact_score") or 0,
            "market_regime": expected_row.get("expected_market_regime") or "UNKNOWN",
            "volume": trade.get("volume") or 0,
            "adx": adx_f,
            "session": session,
            "trend_h1": trend_h1_f,
            "trend_h4": trend_h4_f,
        }

        # ============ Debug log (Feature Vector) ============
        ticket = trade.get("order_id", "unknown")
        open_time_str = "N/A"
        if time_open_ts:
            if hasattr(time_open_ts, "strftime"):
                open_time_str = time_open_ts.strftime("%Y-%m-%d %H:%M:%S")
            elif isinstance(time_open_ts, (int, float)):
                import datetime

                open_time_str = datetime.datetime.fromtimestamp(time_open_ts).strftime("%Y-%m-%d %H:%M:%S")
            elif isinstance(time_open_ts, str):
                open_time_str = time_open_ts[:19]

        import datetime as dt_module

        current_time_str = dt_module.datetime.now().strftime("%Y-%m-%d %H:%M:%S")

        # MISSING-safe display conversions
        adx_display = "MISSING" if features.get("adx") is None else str(features.get("adx"))
        session_display = "MISSING" if features.get("session") is None else str(features.get("session"))
        trend_h1_display = "MISSING" if features.get("trend_h1") is None else str(features.get("trend_h1"))
        trend_h4_display = "MISSING" if features.get("trend_h4") is None else str(features.get("trend_h4"))

        log_news_impact = features.get("news_impact")

        logger.info(
            "========== EXIT MODEL FEATURES =========="
            "\n"
            f"atr: {features.get('atr')} | rsi: {features.get('rsi')} | mfe: {features.get('mfe')} | mae: {features.get('mae')}\n"
            f"trade_health: {features.get('trade_health')} | profit_decay_pct: {features.get('profit_decay_pct')}\n"
            f"time_open_hours: {features.get('time_open_hours')} | spread: {features.get('spread')} | news_impact: {log_news_impact}\n"
            f"market_regime: {features.get('market_regime')} | volume: {features.get('volume')} | session: {session_display}\n"
            f"adx: {adx_display}\n"
            f"trend_h1: {trend_h1_display}\n"
            f"trend_h4: {trend_h4_display}\n"
            "========================================="
            f"\nPrediction about to be called | ticket={ticket} | open_time={open_time_str} | current_time={current_time_str}"
        )

        # Task #3: validate open_time based on MT5 time (timezone correctness)
        # If open_ts_utc ends up in the future vs MT5 time, timezone is wrong -> clamp.
        try:
            symbol_for_time = trade.get("symbol") or expected_row.get("symbol") or "EURUSD"
            now_dt_utc = self.get_mt5_time_safe(symbol_for_time)
            now_ts_utc = now_dt_utc.timestamp()

            # Recompute open_ts_utc from time_open_ts so we can compare reliably.
            open_ts_utc = None
            if time_open_ts:
                from config import BROKER_UTC_OFFSET_HOURS
                offset_seconds = float(BROKER_UTC_OFFSET_HOURS) * 3600.0

                if hasattr(time_open_ts, "timestamp"):
                    ts_broker = float(time_open_ts.timestamp())
                    open_ts_utc = ts_broker - offset_seconds
                elif isinstance(time_open_ts, (int, float)):
                    open_ts_utc = float(time_open_ts) - offset_seconds
                elif isinstance(time_open_ts, str):
                    parsed = time_open_ts.replace("+00:00", "").replace("Z", "")
                    dt = time.strptime(parsed[:19], "%Y-%m-%d %H:%M:%S")
                    ts_broker = float(time.mktime(dt))
                    open_ts_utc = ts_broker - offset_seconds

            if open_ts_utc is not None and open_ts_utc > now_ts_utc + 5:
                logger.warning(
                    f"[EXIT_MODEL] Invalid open_ts_utc (future) => clamp. "
                    f"open_ts_utc={open_ts_utc} now_ts_utc={now_ts_utc} ticket={ticket}"
                )
                # clamp to "opened 1 hour ago" as a safe monotonic proxy
                time_open_hours = 1.0
        except Exception:
            pass

        # ============ Safety check for missing core features ============
        # If any core feature is missing (None or 0.0 after conversion), mark model as unreliable.
        core_feature_names = ["atr", "rsi", "time_open_hours"]
        optional_feature_names = ["adx", "trend_h1", "trend_h4"]

        core_missing = 0
        missing_details = []
        for fn in core_feature_names:
            v = features.get(fn)
            if fn == "time_open_hours":
                # 0.0 is a valid value for a freshly opened trade - only None counts as missing
                is_missing = v is None
            else:
                # Consider 0.0 as missing/unreliable for these (usually means data wasn't fetched)
                is_missing = v is None or float(v) == 0.0
            if is_missing:
                core_missing += 1
                missing_details.append(f"{fn}={v}")

        features_incomplete = core_missing > 0
        if features_incomplete:
            logger.warning(
                f"[EXIT_MODEL] features_incomplete=True (core_missing={core_missing}) ticket={ticket} "
                f"missing_details={';'.join(missing_details)}"
            )
            return {
                "continue_probability": None,
                "exit_probability": None,
                "confidence": None,
                "features_incomplete": True,
            }

        try:
            exit_prob = predict_exit_probability(features)  # probability of ending in loss/reversal
        except Exception:
            logger.warning("[EXIT_MODEL] prediction failed - fallback exit_prob=0.5")
            exit_prob = 0.5

        # =========================
        # Fallback/override logic for exit_probability (Task #1)
        # =========================
        # 1) loss_points calculation from entry_price/current_price
        entry_price = (
            expected_row.get("entry_price")
            or expected_row.get("entry")
            or trade.get("entry_price")
            or trade.get("price_open")
            or trade.get("entryPrice")
        )
        current_price = trade.get("price_current") or trade.get("price") or trade.get("price_current")

        point_size = None
        try:
            import MetaTrader5 as _mt5  # type: ignore

            symbol_for_point = trade.get("symbol") or features.get("symbol")
            if symbol_for_point is not None:
                si = _mt5.symbol_info(str(symbol_for_point))
                if si is not None and getattr(si, "point", None):
                    ps = float(si.point)
                    if ps > 0:
                        point_size = ps
        except Exception:
            point_size = None

        if point_size is None:
            point_size = 0.0001  # fallback

        loss_points: Optional[float] = None
        try:
            if entry_price is not None and current_price is not None:
                entry_price_f = float(entry_price)
                current_price_f = float(current_price)
                direction = str(trade.get("direction") or "")
                if direction.lower() in ["buy", "0"]:
                    loss_points = (current_price_f - entry_price_f) / point_size
                else:
                    loss_points = (entry_price_f - current_price_f) / point_size
        except Exception:
            loss_points = None

        # 2) apply override thresholds (Task #1)
        # If entry/current aren't available -> loss_points stays None -> no-op.
        if loss_points is not None:
            if loss_points <= -15:
                new_exit_prob = max(float(exit_prob), 0.95)
                if new_exit_prob != float(exit_prob):
                    logger.warning(
                        f"[FALLBACK] Extreme loss {loss_points:.1f} pips for ticket={ticket}, forcing exit_prob=0.95"
                    )
                exit_prob = new_exit_prob
            elif -15 < loss_points <= -10:
                new_exit_prob = max(float(exit_prob), 0.80)
                if new_exit_prob != float(exit_prob):
                    logger.warning(
                        f"[FALLBACK] Significant loss {loss_points:.1f} pips for ticket={ticket}, forcing exit_prob=0.80"
                    )
                exit_prob = new_exit_prob

        # Ensure exit_prob stays within [0,1]
        exit_prob = float(max(0.0, min(1.0, float(exit_prob))))

        # 3) write back into expected_row for downstream
        expected_row["exit_probability"] = exit_prob

        # winning probability expected by TradeHealthFlag is inverse of exit_prob
        p_win = float(max(0.0, min(1.0, 1.0 - float(exit_prob))))

        # Important: write back into snapshot expected_row so TradeHealthFlag uses a non-constant value
        expected_row["p_win"] = p_win

        cont_prob = 1.0 - float(exit_prob)
        conf = float(exit_prob)

        logger.info(
            f"[EXIT_MODEL] ticket={ticket} prediction_exit_probability={exit_prob:.4f} decision_signal={exit_prob:.1%}"
        )

        return {"continue_probability": cont_prob, "exit_probability": exit_prob, "confidence": conf, "features_incomplete": False}


